{
  "name": "@kniff/framer-kit",
  "private": true,
  "description": "Native scroll-snap carousels and Kniff lightboxes for Framer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowgrow/framer-kit.git"
  },
  "homepage": "https://github.com/flowgrow/framer-kit#readme",
  "bugs": {
    "url": "https://github.com/flowgrow/framer-kit/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint --react-plugin --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:framer": "playwright test --config playwright.framer.config.ts",
    "test:collector": "vitest run tests/authoredStyles.test.tsx && pnpm run test:framer",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "framer": "3.0.4",
    "oxlint": "1.77.0",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
