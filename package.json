{
  "name": "@kniff/framer-kit",
  "version": "0.1.0-framer-test.2",
  "description": "Bundled, SSR-safe Embla carousel components and overrides for Framer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowgrow/framer-kit.git"
  },
  "homepage": "https://github.com/flowgrow/framer-kit#readme",
  "bugs": {
    "url": "https://github.com/flowgrow/framer-kit/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embla": {
      "types": "./dist/embla.d.ts",
      "import": "./dist/embla.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:framer": "npm run build && node scripts/dev-framer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && changeset publish",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "framer": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-height": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "embla-carousel-wheel-gestures": "8.1.0",
    "zustand": "5.0.14"
  }
}
