{
  "name": "@kniff/framer-kit",
  "version": "0.3.1",
  "description": "Native scroll-snap carousels and Ramka lightboxes for Framer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowgrow/framer-kit.git"
  },
  "homepage": "https://github.com/flowgrow/framer-kit#readme",
  "bugs": {
    "url": "https://github.com/flowgrow/framer-kit/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ramka": {
      "types": "./dist/ramka.d.ts",
      "import": "./dist/ramka.js"
    },
    "./scroll-snap": {
      "types": "./dist/scroll-snap.d.ts",
      "import": "./dist/scroll-snap.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:framer": "pnpm run build && node scripts/dev-framer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run check && changeset publish",
    "prepublishOnly": "pnpm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "framer": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-doctor": "0.9.12",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ramka": "https://pkg.pr.new/arturbien/ramka@1d97a5a"
  }
}
